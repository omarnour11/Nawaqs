# Release signing is configured in `android/key.properties`, which is
# git-ignored. Copy this file to `android/key.properties` and fill in real
# values; never commit the filled-in file or the keystore itself.
#
# Generate a keystore once (keep it safe and backed up — losing it means you
# can never update the app on Google Play):
#
#   keytool -genkey -v -keystore ~/nawaqs-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias nawaqs
#
# Then set storeFile to the ABSOLUTE path of that file, or a path relative to
# the android/ directory.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=nawaqs
storeFile=/absolute/path/to/nawaqs-release.jks
