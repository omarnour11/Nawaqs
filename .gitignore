# ── IDE / OS ──────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Flutter / Dart ────────────────────────────────────
**/dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/generated_plugin_registrant.*
**/build/
**/.pub-cache/
**/.pub/
# pubspec.lock is committed on purpose: CI must resolve the exact same
# transitive build tools as local development so the generated-code
# freshness check compares like with like.
.flutter-plugins
.flutter-plugins-dependencies

# ── Misc ──────────────────────────────────────────────
*.log
logs/
appsettings.*.json
!appsettings.Development.json

# Session artifacts
screenshots/
.freebuff/
.env

# ── Secrets: release signing ──────────────────────────────────────────
# Never commit keystores or their passwords. android/key.properties is
# ignored by src/nawakes_mobile/android/.gitignore; these cover keystores
# stored anywhere else in the repo, including a root-level secrets/ folder.
secrets/
*.jks
*.keystore
key.properties
